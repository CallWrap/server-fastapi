# 이 파일에는 값을 채우지 않는다. 실제 값은 .env에만 (커밋 금지 — .gitignore 처리됨).
# 비워두면 src/callwrap_api/settings.py의 기본값(로컬 docker compose)을 쓴다.
# docker compose로 전체를 띄울 때는 compose가 값을 주입하므로 여기 안 채워도 된다.
#
# ※ 무상태 워커 — DB는 Spring이 소유한다. DATABASE_URL은 여기 없다.

# RabbitMQ — Celery broker 겸 Spring↔FastAPI 메시징. 로컬 기본값: amqp://guest:guest@localhost:5672//
RABBITMQ_URL=

# STT 백엔드: stub | (whisper 등은 stt/ 연동 후 추가). 기본 stub.
STT_BACKEND=

# 오디오 취득: local(로컬/공유볼륨 경로) | (S3/MinIO 등은 스토리지 확정 후 추가). 기본 local.
AUDIO_SOURCE=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
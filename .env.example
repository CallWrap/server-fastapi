# 이 파일에는 값을 채우지 않는다. 실제 값은 .env에만 (커밋 금지 — .gitignore 처리됨).
# 비워두면 src/callwrap_api/settings.py의 기본값(로컬 docker compose)을 쓴다.
# docker compose로 전체를 띄울 때는 compose가 값을 주입하므로 여기 안 채워도 된다.

# Postgres. 로컬 기본값: postgresql+psycopg://callwrap:callwrap@localhost:5432/callwrap
DATABASE_URL=

# Redis — Celery 브로커 겸 결과 백엔드. 로컬 기본값: redis://localhost:6379/0
# (RabbitMQ 전환은 로드맵 P2 — 그때 BROKER_URL 등으로 대체 예정)
REDIS_URL=

# STT 백엔드: stub | (whisper 등은 stt/ 연동 후 추가). 기본 stub.
STT_BACKEND=

# 파이프라인 흐름 테스트(DB 필요)에서만 사용. 없으면 해당 테스트는 자동 skip.
CALLWRAP_TEST_DATABASE_URL=

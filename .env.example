# 이 파일에는 값을 채우지 않는다. 실제 값은 .env에만 (커밋 금지 — .gitignore 처리됨).
# 비워두면 src/callwrap_api/settings.py의 기본값(로컬 docker compose)을 쓴다.
# docker compose로 전체를 띄울 때는 compose가 값을 주입하므로 여기 안 채워도 된다.
#
# ※ 무상태 워커 — DB는 Spring이 소유한다. DATABASE_URL은 여기 없다.

# RabbitMQ — Celery broker 겸 Spring↔FastAPI 메시징. 로컬 기본값: amqp://guest:guest@localhost:5672//
RABBITMQ_URL=

# STT 백엔드: stub | whisper. 기본 stub.
STT_BACKEND=whisper
# stt_backend=whisper 일 때만: faster-whisper 모델 크기, pyannote용 HF 토큰
WHISPER_MODEL=large-v3
HF_TOKEN=

# 오디오 취득: local(로컬/공유볼륨 경로) | (S3/MinIO 등은 스토리지 확정 후 추가). 기본 local.
AUDIO_SOURCE=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# F2(중분류·소분류) 분류 모델 체크포인트가 실제로 있는 호스트 경로.
# worker 컨테이너의 /app/models로 마운트된다 (docker-compose.yml 참고).
# AI-model은 로컬 재현 학습 구조라 이 레포엔 체크포인트가 없다 — 직접 학습해서 나온
# category-klue-roberta-base-seed42/, subcategory-klue-roberta-base-seed42/ 폴더의
# 부모 경로를 넣는다. 비워두면 빈 폴더가 마운트되고 classify는 계속 부분 실패로 넘어간다.
CALLWRAP_MODEL_DIR_HOST=